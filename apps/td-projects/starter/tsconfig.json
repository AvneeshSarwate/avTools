{
  "extends": "./.td/tsconfig.paths.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["sketches/**/*.ts", "shared/**/*.ts", "generated/**/*.ts", "td-sketches.config.ts"]
}
