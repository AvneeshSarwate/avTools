{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "livecode",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    // Keep this false until the workers.dev hostname is protected by Access.
    "LIVECODE_ENABLED": "false"
  },
  "assets": {
    "directory": "./terminal-dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "Sandbox",
        "class_name": "Sandbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Sandbox"]
    }
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      "instance_type": "standard-2",
      "max_instances": 1
    }
  ],
  "r2_buckets": [
    {
      "binding": "LIVECODE_STATE",
      "bucket_name": "avtools-livecode-state"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
