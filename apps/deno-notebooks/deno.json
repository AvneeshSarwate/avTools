{
  "unstable": [
    "webgpu"
  ],
  "tasks": {
    "dev": "deno run --watch main.ts",
    "install": "deno cache --node-modules-dir=auto tools/osc.ts",
    "test:p5:browser": "deno run --unstable-webgpu --unstable-ffi --allow-ffi --allow-read --allow-env --allow-write --allow-run --allow-net libraryIntegrationTetsts/p5_browser_comparison_tests.ts",
    "test:p5:browser:text": "P5GPU_MAX_PHASE=6 P5GPU_NAME_FILTER='text-' deno run --unstable-webgpu --unstable-ffi --allow-ffi --allow-read --allow-env --allow-write --allow-run --allow-net libraryIntegrationTetsts/p5_browser_comparison_tests.ts",
    "test:livecode:unit": "deno test --allow-env --allow-sys --allow-read --allow-write livecode_visualizer_tests/analyzer_transform_test.ts livecode_visualizer_tests/runtime_counts_test.ts livecode_visualizer_tests/dynamic_import_execution_test.ts",
    "test:livecode:server": "deno test --allow-all livecode_visualizer_tests/protocol_smoke_test.ts livecode_visualizer_tests/lsp_smoke_test.ts livecode_visualizer_tests/server_smoke_test.ts livecode_visualizer_tests/default_source_integration_test.ts",
    "test:livecode:e2e": "cd ../browser-projections && npm run test:livecode:e2e",
    "test:livecode": "deno task test:livecode:unit && deno task test:livecode:server && deno task test:livecode:e2e",
    "watch:power2d-raw": "deno run --allow-read --allow-write ../../tools/shader-watch/watch_power2d_raw.ts ./shaders ../../packages/power2d/generated-raw",
    "watch:shaderfx-raw": "deno run --allow-read --allow-write ../../tools/shader-watch/watch_shaderfx_raw.ts ./shaders ../../packages/shader-fx/generated-raw",
    "gen:shaderfx-raw": "deno run --allow-read --allow-write generate_shaderfx_raw.ts ./shaders ../../packages/shader-fx/generated-raw",
    "watch:compute-raw": "deno run --allow-read --allow-write ../../tools/shader-watch/watch_compute_raw.ts ./shaders ../../packages/compute-shader/generated-raw"
  },
  "imports": {
    "@gfx/canvas": "jsr:@gfx/canvas@^0.5.8",
    "@gfx/canvas-wasm": "jsr:@gfx/canvas-wasm@^0.4.2",
    "@std/assert": "jsr:@std/assert@1",
    "@std/random": "jsr:@std/random@^0.1.4",
    "@valtown/ls-ws-server": "npm:@valtown/ls-ws-server@0.0.26",
    "@valtown/ls-ws-server/proxy": "npm:@valtown/ls-ws-server@0.0.26/proxy",
    "earcut": "npm:earcut@^3",
    "fast-xml-parser": "npm:fast-xml-parser@4.3.5",
    "node-osc": "npm:node-osc@^9.1.0",
    "node-web-audio-api": "npm:node-web-audio-api",
    "pako": "npm:pako@2.1.0",
    "three": "npm:three@^0.178.0",
    "midi-helpers": "./livecode_helpers/midi_helpers.ts",
    "@babylonjs/core": "npm:@babylonjs/core@^8.20.0",
    "tone": "npm:tone",
    "gifenc": "npm:gifenc@1.0.3/dist/gifenc.esm.js",
    "@avtools/core-timing": "../../packages/core-timing/mod.ts",
    "@avtools/creative-algs": "../../packages/creative-algs/mod.ts",
    "@avtools/music-types": "../../packages/music-types/mod.ts",
    "@avtools/ui-bridge": "../../packages/ui-bridge/mod.ts",
    "@avtools/power2d": "../../packages/power2d/mod.ts",
    "@avtools/power2d/core": "../../packages/power2d/core/mod.ts",
    "@avtools/power2d/babylon": "../../packages/power2d/babylon/mod.ts",
    "@avtools/power2d/raw": "../../packages/power2d/raw/mod.ts",
    "@avtools/codegen-common": "../../packages/codegen-common/mod.ts",
    "@avtools/power2d-codegen": "../../packages/power2d-codegen/mod.ts",
    "@avtools/compute-shader-codegen": "../../packages/compute-shader-codegen/mod.ts",
    "@avtools/shader-fx-codegen": "../../packages/shader-fx-codegen/mod.ts",
    "@avtools/power2d/generated/": "../../packages/power2d/generated/",
    "@avtools/power2d/generated-raw/": "../../packages/power2d/generated-raw/",
    "@avtools/compute-shader/generated/": "../../packages/compute-shader/generated/",
    "@avtools/compute-shader/generated-raw/": "../../packages/compute-shader/generated-raw/",
    "@avtools/shader-fx": "../../packages/shader-fx/mod.ts",
    "@avtools/shader-fx/babylon": "../../packages/shader-fx/babylon/mod.ts",
    "@avtools/shader-fx/babylonGL": "../../packages/shader-fx/babylonGL/mod.ts",
    "@avtools/shader-fx/generated/": "../../packages/shader-fx/generated/",
    "@avtools/shader-fx/raw": "../../packages/shader-fx/raw/mod.ts",
    "@avtools/shader-fx/generated-raw/": "../../packages/shader-fx/generated-raw/",
    "@/": "./",
    "react": "npm:react@^19",
    "pixi.js": "npm:pixi.js@^8",
    "@pixi/react": "npm:@pixi/react@8.0.5",
    "@pixi/layout": "npm:@pixi/layout@^3",
    "@pixi/layout/components": "npm:@pixi/layout@^3/components",
    "@pixi/ui": "npm:@pixi/ui@^2",
    "p5": "npm:p5@^2",
    "tweakpane": "npm:tweakpane@^4",
    "1eurofilter": "npm:1eurofilter@^1.3.0"
  }
}
