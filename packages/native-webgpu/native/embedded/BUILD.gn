# Copied into the pinned Dawn source tree by scripts/embedding.mjs (macOS) or
# scripts/embedding-win.mjs (Windows).
if (is_mac) {
  source_set("runtime") {
    sources = [ "IO.cpp", "IO.h", "WebSocket.mm", "WebSocket.h", "MIDI.h", "Runtime.cpp", "Runtime.h", "LogSink.h", "LogFormat.h", "HostLoop.cpp", "HostLoop.h", "TextCompat.cpp", "dawn_syphon.mm", "text_addon.cpp", "//src/dawn/node/Module.cpp", "//src/dawn/node/ManualConstructors.cpp" ]
    cflags_objcc = [ "-fno-objc-arc" ]
    defines = [ "AVTOOLS_EMBEDDED=1", "AVTOOLS_EMBEDDED_SYPHON=1", "NAPI_VERSION=8", "DAWN_ENABLE_BACKEND_METAL" ]
    include_dirs = [ "//third_party/v8/src", "$root_gen_dir/third_party/v8/src", "//", "$root_gen_dir/src/dawn/node", "$root_gen_dir/src", "@SYPHON_INCLUDE@", "@LIBUV_INCLUDE@" ]
    configs -= [ "//build/config/compiler:no_exceptions", "//build/config/compiler:enable_arc" ]
    configs += [ "//build/config/compiler:exceptions", "//src/dawn/node:common_config", "//src/tint:tint_public_config" ]
    deps = [ "//src/dawn/native:sources", "//src/dawn/node:dawn_node_binding", "//src/dawn/node/napi_v8:napi_v8", "//src/dawn:proc", "//third_party/v8/src:v8_libplatform" ]
  }
  executable("embedded-probe") {
    ldflags = [ "-Wl,-rpath,@SYPHON_FRAMEWORK_DIR@" ]
    sources = [ "probe.cpp" ]
    include_dirs = [ "//" ]
    deps = [ ":runtime", "//src/dawn/node/napi_v8:napi_v8", "//third_party/v8/src:v8_libplatform" ]
    libs = [ "@LIBUV_LIBRARY@", "@RUST_RUNTIME_LIBRARY@", "@SYPHON_LIBRARY@", "iconv" ]
    frameworks = [ "Foundation.framework", "CoreMIDI.framework", "CoreAudio.framework", "CoreFoundation.framework", "Security.framework" ]
  }

  shared_library("avtools_runtime") {
    sources = [ "Bridge.cpp", "Bridge.h", "ChopExchange.h" ]
    include_dirs = [ "//" ]
    configs -= [ "//build/config/compiler:no_exceptions" ]
    configs += [ "//build/config/compiler:exceptions" ]
    deps = [ ":runtime", "//src/dawn/node/napi_v8:napi_v8", "//third_party/v8/src:v8_libplatform" ]
    libs = [ "@LIBUV_LIBRARY@", "@RUST_RUNTIME_LIBRARY@", "@SYPHON_LIBRARY@", "iconv" ]
    frameworks = [ "Foundation.framework", "CoreMIDI.framework", "CoreAudio.framework", "CoreFoundation.framework", "Security.framework" ]
    ldflags = [ "-Wl,-rpath,@loader_path", "-Wl,-exported_symbols_list," + rebase_path("exports.txt", root_build_dir), "-Wl,-install_name,@loader_path/libavtools_runtime.dylib" ]
  }
} else if (is_win) {
  # Windows: one self-contained DLL per operator (see plans/windows-build-plan.md).
  # TD glue, Bridge, V8, Dawn (D3D12 + Vulkan), libuv and the single Rust staticlib
  # (TypeScript compiler + MIDI + text) link into it with one toolchain and /MT.
  # V8 embedder defines (pointer compression is on for Windows; must match V8 itself).
  _avtools_win_libs = [
    "@LIBUV_LIBRARY@",
    "@RUST_WINDOWS_LIBRARY@",
    "winhttp.lib", "winmm.lib", "bcrypt.lib", "ws2_32.lib", "iphlpapi.lib", "userenv.lib",
    "psapi.lib", "dbghelp.lib", "ole32.lib", "shell32.lib", "advapi32.lib", "ntdll.lib", "synchronization.lib",
  ]
  source_set("runtime") {
    sources = [ "IO.cpp", "IO.h", "WebSocket_win.cpp", "WebSocket.h", "MIDI.h", "Runtime.cpp", "Runtime.h", "LogSink.h", "LogFormat.h", "HostLoop.cpp", "HostLoop.h", "TextCompat.cpp", "Platform.h", "platform_stubs_win.cpp", "text_addon.cpp", "//src/dawn/node/Module.cpp", "//src/dawn/node/ManualConstructors.cpp" ]
    defines = [ "AVTOOLS_EMBEDDED=1", "NAPI_VERSION=8", "DAWN_ENABLE_BACKEND_D3D12", "DAWN_ENABLE_BACKEND_VULKAN" ]
    include_dirs = [ "//third_party/v8/src", "$root_gen_dir/third_party/v8/src", "//", "$root_gen_dir/src/dawn/node", "$root_gen_dir/src", "@LIBUV_INCLUDE@" ]
    configs -= [ "//build/config/compiler:no_exceptions" ]
    configs += [ "//build/config/compiler:exceptions", "//third_party/v8/src:external_config", "//src/dawn/node:common_config", "//src/tint:tint_public_config" ]
    deps = [ "//src/dawn/native:sources", "//src/dawn/node:dawn_node_binding", "//src/dawn/node/napi_v8:napi_v8", "//src/dawn:proc", "//third_party/v8/src:v8_libplatform" ]
  }
  executable("embedded-probe") {
    sources = [ "probe.cpp" ]
    include_dirs = [ "//" ]
    configs -= [ "//build/config/compiler:no_exceptions" ]
    configs += [ "//build/config/compiler:exceptions", "//third_party/v8/src:external_config" ]
    deps = [ ":runtime", "//src/dawn/node/napi_v8:napi_v8", "//third_party/v8/src:v8_libplatform" ]
    libs = _avtools_win_libs
  }
  template("avtools_operator") {
    shared_library(target_name) {
      output_name = target_name
      # generated/<name>.rc embeds Resources (renderer/chop JS, fonts, DeclaredParameters.py)
      # as RCDATA; written by scripts/build-td-plugin.mjs before ninja runs.
      sources = [ "Bridge.cpp", "Bridge.h", "ChopExchange.h", invoker.glue, "generated/${target_name}.rc" ]
      include_dirs = [ "//", invoker.td_headers ]
      configs -= [ "//build/config/compiler:no_exceptions" ]
      configs += [ "//build/config/compiler:exceptions", "//third_party/v8/src:external_config" ]
      deps = [ ":runtime", "//src/dawn/node/napi_v8:napi_v8", "//third_party/v8/src:v8_libplatform" ]
      libs = _avtools_win_libs
    }
  }
  avtools_operator("AvToolsSketch") {
    glue = "@TD_SOURCE_DIR@/SketchTOP.cpp"
    td_headers = "@TD_TOP_HEADERS@"
  }
  avtools_operator("AvToolsChannels") {
    glue = "@TD_SOURCE_DIR@/SketchCHOP.cpp"
    td_headers = "@TD_CHOP_HEADERS@"
  }
}
