if(NOT EXISTS "${AVTOOLS_WINDOW_LIBRARY}")
  message(FATAL_ERROR "Build the Rust window static library and set AVTOOLS_WINDOW_LIBRARY")
endif()
target_sources(dawn_node PRIVATE "${AVTOOLS_NATIVE_DIR}/dawn_window.mm")
target_include_directories(dawn_node PRIVATE "${AVTOOLS_NATIVE_DIR}")
target_link_libraries(dawn_node PRIVATE "${AVTOOLS_WINDOW_LIBRARY}"
  "-framework WebKit" "-framework Security" "-framework Carbon" "-framework CoreGraphics" iconv)
set_source_files_properties("${AVTOOLS_NATIVE_DIR}/dawn_window.mm" PROPERTIES LANGUAGE CXX COMPILE_FLAGS "-x objective-c++ -std=c++20")
# Build the pinned Syphon source separately before linking this extension.
set(SYPHON_SOURCE "${AVTOOLS_NATIVE_DIR}/../upstream/syphon")
set(SYPHON_FRAMEWORK "${AVTOOLS_NATIVE_DIR}/../build/syphon/Syphon.framework")
foreach(header SyphonMetalServer.h SyphonServerBase.h SyphonMetalClient.h SyphonClientBase.h)
  configure_file("${SYPHON_SOURCE}/${header}" "${CMAKE_BINARY_DIR}/avtools-include/Syphon/${header}" COPYONLY)
endforeach()
target_include_directories(dawn_node PRIVATE "${CMAKE_BINARY_DIR}/avtools-include" "${CMAKE_BINARY_DIR}/gen/src")
target_sources(dawn_node PRIVATE "${AVTOOLS_NATIVE_DIR}/dawn_syphon.mm")
set_source_files_properties("${AVTOOLS_NATIVE_DIR}/dawn_syphon.mm" PROPERTIES LANGUAGE CXX COMPILE_FLAGS "-x objective-c++ -std=c++20")
target_link_libraries(dawn_node PRIVATE "${SYPHON_FRAMEWORK}/Versions/A/Syphon")
set_target_properties(dawn_node PROPERTIES BUILD_WITH_INSTALL_RPATH TRUE INSTALL_RPATH "@loader_path")
