+// avTools: native callback lifetime, independent of V8/Node implementation.
+#pragma once
+#include <atomic>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+#include "src/dawn/node/interop/NodeAPI.h"
+namespace wgpu::interop {
+struct EnvironmentLifetime {
+    std::atomic<bool> retired{false};
+    // Owner-thread cleanup; weak captures only. No JS is invoked during retirement.
+    std::vector<std::function<void()>> cleanup;
+};
+inline std::mutex environmentMutex;
+inline std::unordered_map<napi_env,std::weak_ptr<EnvironmentLifetime>> environments;
+inline std::shared_ptr<EnvironmentLifetime> EnvironmentFor(napi_env env) {
+    std::lock_guard lock(environmentMutex);
+    auto& slot=environments[env];auto life=slot.lock();
+    if(!life){life=std::make_shared<EnvironmentLifetime>();slot=life;}
+    return life;
+}
+inline void RetireEnvironment(napi_env env) {
+    std::shared_ptr<EnvironmentLifetime> life;
+    {std::lock_guard lock(environmentMutex);auto it=environments.find(env);if(it==environments.end())return;life=it->second.lock();environments.erase(it);}
+    if(!life)return;
+    life->retired=true;
+    auto cleanup=std::move(life->cleanup);
+    for(auto& fn:cleanup)fn();
+}
+}
