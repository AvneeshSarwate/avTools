+    // with it (Windows), making napi_wrap report "Object is already wrapped". Make
+    // the unwrapped state explicit so napi_wrap/unwrap/remove_wrap are well-defined.
+    if (v8_info.IsConstructCall()) {
+        v8::Local<v8::Object> self = v8_info.This();
+        if (self->InternalFieldCount() > 0) {
+            self->SetAlignedPointerInInternalField(0, nullptr, v8::kEmbedderDataTypeTagDefault);
+        }
+    }
